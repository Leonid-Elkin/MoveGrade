{
  "manifest_version": 3,
  "name": "MoveGrade",
  "version": "0.3.0",
  "description": "Live move-quality badges (Brilliant, Best, Blunder...) overlaid on lichess and chess.com games you watch, analyse, or play against the computer.",
  "permissions": ["storage", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["https://lichess.org/*", "https://www.chess.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "MoveGrade: show/hide overlay" },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay/*", "engine/*", "lib/*", "pieces/*"],
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"]
    }
  ],
  "icons": { "128": "icons/icon128.png" }
}
